// A systemLibrary target's module map is hand-written, not auto-generated
// by SwiftPM the way a normal C target's is. This is what actually makes
// libarchive's headers visible to every target that depends on CArchive,
// including cross-target Swift imports - a plain .target's cSettings only
// apply when compiling that target's own C files, not when other targets
// import it, which is exactly the propagation this systemLibrary target
// exists to provide instead.
//
// Absolute paths are used directly here, rather than resolving through
// pkg-config, because Homebrew installs libarchive "keg-only" (its .pc
// file lives outside the default PKG_CONFIG_PATH) and this project already
// assumes an Apple Silicon Homebrew layout elsewhere (see the launchd
// plist and the CI workflow).
//
// Note on what links at runtime: macOS also ships its own public libarchive
// dylib at /usr/lib. Without an explicit -L flag, the linker would resolve
// `link "archive"` to that system copy instead of Homebrew's, which was
// confirmed with `otool -L` and by logging archive_version_string() at
// runtime: it reported Apple's bundled 3.7.4, not Homebrew's 3.8.9, even
// though the headers this module map exposes come from 3.8.9. That header
// and runtime library mismatch happened to be harmless for the small,
// long-stable subset of the API used here, but "happened to be harmless"
// is not the same as correct, so DarwinDaemon and SandboxSecurityTests
// (the two final linked products that actually pull libarchive in) now
// carry an explicit `-L/opt/homebrew/opt/libarchive/lib` linkerSetting in
// Package.swift, forcing them to link the same copy these headers
// describe. See DEBUGGING_LOG.md for the full story.
module CArchive [system] {
    header "/opt/homebrew/opt/libarchive/include/archive.h"
    header "/opt/homebrew/opt/libarchive/include/archive_entry.h"
    link "archive"
    export *
}
